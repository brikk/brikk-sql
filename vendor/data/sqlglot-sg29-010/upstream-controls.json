      "upstream_output": "SELECT JSONExtractRaw(payload, '12')"
    },
    {
      "source": "clickhouse",
      "target": "clickhouse",
      "sql": "SELECT JSONExtractRaw(payload, 'a', 1)",
      "upstream_output": "SELECT JSONExtractRaw(payload, 'a', 1)"
    }
  ]
